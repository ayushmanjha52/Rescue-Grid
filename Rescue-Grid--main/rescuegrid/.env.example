# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (required) -----------------------------------------------------
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by every API route; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only for `bun run db:setup` (creates the tables). Supabase dashboard →
# Connect → "Session pooler" connection string, with your database password.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Site ---------------------------------------------------------------------
# Public address, used for the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Auth ---------------------------------------------------------------------
# Volunteers sign in with Supabase phone OTP; operators with Supabase email/password.
# Comma separated emails allowed into the DMA dashboard. Leave empty to allow any
# email/password Supabase user (only safe if public sign-ups are disabled).
DMA_ALLOWED_EMAILS=dma@example.org

# --- Maps (required for maps & geocoding) -------------------------------------
# Restrict this token to your site's URL in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# --- SMS / helpline -----------------------------------------------------------
# Optional, paid: Twilio number that receives SOS texts as reports (twilio-sms-webhook).
# If empty, SOS texts go to 112 instead.
NEXT_PUBLIC_TWILIO_SMS_NUMBER=
# Number shown as "Call helpline" (your control room). Defaults to 112.
NEXT_PUBLIC_HELPLINE_NUMBER=

# --- Bot protection for volunteer sign-up (optional) --------------------------
# Cloudflare Turnstile: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Web push for volunteers (optional) ---------------------------------------
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:ops@example.org

# --- DRIS AI assistant (optional) ---------------------------------------------
OPENAI_API_KEY=sk-...
# Supabase MCP (read-only) used by the assistant to query live data.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token

# --- Development (optional) ---------------------------------------------------
# Extra origins allowed to use the dev server, e.g. your LAN IP for phone testing.
ALLOWED_DEV_ORIGINS=
